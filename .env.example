# Copy to .env and adjust. docker-compose reads this file automatically.

# --- database ---
POSTGRES_USER=peoplepay
POSTGRES_PASSWORD=peoplepay
POSTGRES_DB=peoplepay360
# Host port for psql/DBeaver. Change if 5432 is already taken locally.
POSTGRES_PORT_HOST=5432

# --- security ---
# Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-key-change-me-before-deploying-anywhere

# --- app ---
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- mail ---
# Points at the Mailpit container in compose. Swap for real SMTP to send
# actual payslip emails; the inbox UI is at http://localhost:8025
SMTP_HOST=mail
SMTP_PORT=1025
MAIL_FROM=payroll@peoplepay360.com
