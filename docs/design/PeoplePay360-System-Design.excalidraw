amily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": false}, {"id": "e01032", "type": "text", "x": 1766, "y": 7554.25, "width": 748, "height": 18.75, "angle": 0, "strokeColor": "#5c5f66", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1413003085, "version": 12, "versionNonce": 944479142, "isDeleted": false, "boundElements": null, "updated": 1757000000000, "link": null, "locked": false, "text": "Enforced in the service layer, so no router can forget it.", "originalText": "Enforced in the service layer, so no router can forget it.", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": false}, {"id": "e01033", "type": "text", "x": 2604, "y": 7414.25, "width": 218.675, "height": 18.75, "angle": 0, "strokeColor": "#f08c00", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1676904890, "version": 12, "versionNonce": 29513087, "isDeleted": false, "boundElements": null, "updated": 1757000000000, "link": null, "locked": false, "text": "ONE SPEC AMBIGUITY, FLAGGED", "originalText": "ONE SPEC AMBIGUITY, FLAGGED", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e01034", "type": "rectangle", "x": 2600, "y": 7440.25, "width": 800, "height": 145.0, "angle": 0, "strokeColor": "#f08c00", "backgroundColor": "#fff9db", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1004824006, "version": 12, "versionNonce": 1701216451, "isDeleted": false, "boundElements": null, "updated": 1757000000000, "link": null, "locked": false}, {"id": "e01035", "type": "text", "x": 2620, "y": 7458.25, "width": 760, "height": 105.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1049104939, "version": 12, "versionNonce": 162561006, "isDeleted": false, "boundElements": null, "updated": 1757000000000, "link": null, "locked": false, "text": "- Page 3 gives employees no payroll access and does not\n-   list payslip viewing. So /payslips stays closed to\n-   EMPLOYEE; they receive payslips by email instead.\n- If we would rather they see their own in-app, it is a\n-   one-line change to the matrix. The strict reading is\n-   the default because it matches the brief.", "originalText": "- Page 3 gives employees no payroll access and does not\n-   list payslip viewing. So /payslips stays closed to\n-   EMPLOYEE; they receive payslips by email instead.\n- If we would rather they see their own in-app, it is a\n-   one-line change to the matrix. The strict reading is\n-   the default because it matches the brief.", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": false}, {"id": "e01036", "type": "text", "x": 0, "y": 7954.25, "width": 18.05, "height": 18.75, "angle": 0, "strokeColor": "#f08c00", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1662604848, "version": 12, "versionNonce": 1540574003, "isDeleted": false, "boundElements": null, "updated": 1757000000000, "link": null, "locked": false, "text": "09", "originalText": "09", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": 