": 12, "versionNonce": 245771494, "isDeleted": false, "boundElements": null, "updated": 1757000000000, "link": null, "locked": false}, {"id": "e00919", "type": "text", "x": 2380, "y": 6506.25, "width": 1000, "height": 122.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 709478920, "version": 12, "versionNonce": 353073012, "isDeleted": false, "boundElements": null, "updated": 1757000000000, "link": null, "locked": false, "text": "- Configuration screens are functional and integrated,\n-   not static mockups - the brief says so twice.\n- The dashboard reflects real-time live data instead of\n-   relying on static charts.\n- Smart buttons show real counts, from one\n-   /employees/{id}/summary call - not five round trips.\n- Salary rules actively drive payslip generation.", "originalText": "- Configuration screens are functional and integrated,\n-   not static mockups - the brief says so twice.\n- The dashboard reflects real-time live data instead of\n-   relying on static charts.\n- Smart buttons show real counts, from one\n-   /employees/{id}/summary call - not five round trips.\n- Salary rules actively drive payslip generation.", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": false}, {"id": "e00920", "type": "rectangle", "x": 2360, "y": 6754.25, "width": 1040, "height": 250, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1580938906, "version": 12, "versionNonce": 995012700, "isDeleted": false, "boundElements": null, "updated": 1757000000000, "link": null, "locked": false}, {"id": "e00921", "type": "text", "x": 2386, "y": 6