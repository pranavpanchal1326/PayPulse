# Frontend environment. Copy to `.env.local` and adjust — Vite reads that file
# automatically and it is not committed.

# mock | live
#
#   mock  every PRD §5 endpoint is served from `src/mocks` — the whole product,
#         no backend running. The default in development.
#   live  nothing is intercepted; the app talks to VITE_API_BASE_URL. Only
#         `/auth` exists there today (backend is at B0), so most screens will
#         be empty until the matching B-block ships.
#
# The five demo logins and the password are identical in both modes.
VITE_API_MODE=mock

# Where the real API lives. Compose publishes it on API_PORT_HOST (see the
# repo-root .env.example) — 8100 on this machine, because 8000 was taken.
VITE_API_BASE_URL=http://localhost:8100

# Artificial latency per mocked request, in milliseconds. Set to 0 under a test
# runner; leave it alone otherwise, so loading states stay honest.
# VITE_MOCK_LATENCY=120
